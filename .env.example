# ===== 数据库 =====
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sagerag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456

# ===== RocketMQ =====
ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# ===== MCP Server =====
MCP_SERVER_URL=http://localhost:9099

# ===== 文件存储：local / s3 =====
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=./data/uploads
# STORAGE_TYPE=s3
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=rustfsadmin
# S3_SECRET_KEY=rustfsadmin

# ===== 模型服务（至少配置一个 chat + 一个 embedding）=====
# 百炼：chat(qwen3.8-max-0902) / embedding(qwen3.7-text-embedding-flash) / rerank(qwen3.7-text-rerank)
BAILIAN_API_KEY=
# 硅基流动：作为 chat / embedding 的备用通道
SILICONFLOW_API_KEY=
# 本地 Ollama（可选）
OLLAMA_BASE_URL=http://localhost:11434

# 向量维度：qwen3.7-text-embedding-flash 为 1024
EMBEDDING_DIMENSION=1024
